BASE_URL=http://localhost:8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webgis_db

# Jika dijalankan dengan docker compose:
# DB_URI=postgresql+asyncpg://postgres:postgres@postgis:5432/webgis_db
#
# Jika tanpa docker compose:
# DB_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/webgis_db
#
# sesuaikan jika menggunakan kredensial database yang berbeda.
DB_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/webgis_db

JWT_SECRET_KEY=jwt_secret_key
ACCESS_TOKEN_EXPIRE_HOURS=24

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4173"]
